<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_aquarium_fish_batch" model="ir.sequence">
            <field name="name">Aquarium Fish Batch</field>
            <field name="code">aquarium.fish.batch</field>
            <field name="prefix">BATCH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_aquarium_fish_mortality" model="ir.sequence">
            <field name="name">Aquarium Fish Mortality</field>
            <field name="code">aquarium.fish.mortality</field>
            <field name="prefix">MORT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_aquarium_fish_transfer" model="ir.sequence">
            <field name="name">Aquarium Fish Transfer</field>
            <field name="code">aquarium.fish.transfer</field>
            <field name="prefix">XFER/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="fish_category_freshwater" model="aquarium.fish.category">
            <field name="name">Freshwater Fish</field>
            <field name="sequence">10</field>
        </record>
        <record id="fish_category_marine" model="aquarium.fish.category">
            <field name="name">Marine Fish</field>
            <field name="sequence">20</field>
        </record>
        <record id="fish_category_shrimp" model="aquarium.fish.category">
            <field name="name">Shrimp / Aquatic Animals</field>
            <field name="sequence">30</field>
        </record>
        <record id="fish_category_plants" model="aquarium.fish.category">
            <field name="name">Aquatic Plants</field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
