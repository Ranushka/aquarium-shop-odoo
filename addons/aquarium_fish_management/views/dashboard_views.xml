<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fish_dashboard_form" model="ir.ui.view">
        <field name="name">aquarium.fish.dashboard.form</field>
        <field name="model">aquarium.fish.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"/>
                </header>
                <sheet>
                    <group string="Sales Split (Fish vs Accessories)">
                        <field name="fish_sales_total"/>
                        <field name="accessory_sales_total"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Mortality Alerts">
                        <field name="mortality_alert_count"/>
                    </group>
                    <group string="Best Selling Fish">
                        <field name="best_selling_species_id" readonly="1"/>
                        <field name="best_selling_species_qty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fish_dashboard" model="ir.actions.act_window">
        <field name="name">Fish Dashboard</field>
        <field name="res_model">aquarium.fish.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
